  "firestore": {
    "/admins/{adminId}": {
      "schema": "AdminRole",
      "description": "Trusted administrator lookup table."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Workspace team member profile (non-PII)."
    },
    "/users/{userId}/private/{docId}": {
      "schema": "UserPrivateInfo",
      "description": "Isolated private PII contact details for a user."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Building material catalogue and live stock quantities."
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Approved material suppliers and manufacturers."
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Trade customers, contractors, and architectural firms."
    },
    "/purchases/{purchaseId}": {
      "schema": "PurchaseOrder",
      "description": "Inward purchase orders and restock records."
    },
    "/sales/{saleId}": {
      "schema": "SaleInvoice",
      "description": "Outward sales transactions and tax invoices."
    },
    "/sales/{saleId}/items/{itemId}": {
      "schema": "SaleLineItem",
      "description": "Line items belonging to a specific SaleInvoice."
    },
    "/stockMovements/{movementId}": {
      "schema": "StockMovement",
      "description": "Audit log of stock additions, deductions, and manual adjustments."
    },
    "/settings/{settingId}": {
      "schema": "BusinessSettings",
      "description": "Business profile, tax rate, and invoice configuration."
    }
  }
}
