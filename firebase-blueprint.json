          "maxLength": 160,
          "description": "Private email address."
        },
        "phone": {
          "type": "string",
          "maxLength": 40,
          "description": "Private phone number."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of update."
        }
      },
      "required": ["uid", "email", "phone", "updatedAt"]
    },
