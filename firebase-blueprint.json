{
  "entities": {
    "AdminRole": {
      "title": "AdminRole",
      "description": "Trusted administrator registry document keyed by user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Administrator user UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160,
          "description": "Verified administrator email."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Workspace user profile containing non-PII operational role metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner user UID."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name of the team member."
        },
        "role": {
          "type": "string",
          "enum": ["Admin", "Store Manager", "Inventory Clerk", "Billing Executive"],
          "maxLength": 40,
          "description": "Operational role within BuildFlow Supply."
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Assigned yard or department."
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Suspended"],
          "maxLength": 20,
          "description": "Account status."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["uid", "name", "role", "department", "status", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII subcollection document for user contact details.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
